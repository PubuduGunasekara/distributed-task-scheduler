# ============================================================
# Environment variable template for production deployment.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — NEVER commit it.
# In production these are injected via Kubernetes Secrets,
# AWS Secrets Manager, Docker secrets, or your platform's
# secret store — not from a file on disk.
# ============================================================

# ----- Application -----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ----- PostgreSQL -----
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=taskscheduler
DB_USER=taskscheduler
DB_PASSWORD=CHANGE_ME_strong_password
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# ----- Redis -----
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_POOL_MAX=16

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=your-kafka-broker:9092

# ----- Rate Limiting -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60